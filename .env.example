# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.

# --- Database (Supabase Postgres) ---
# DATABASE_URL: the POOLED connection string (Supabase dashboard -> Connect ->
#   "Transaction pooler", port 6543). Used by the running app and the CLI.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres"
# DIRECT_URL: the DIRECT (non-pooled) connection string (Supabase dashboard ->
#   Connect -> "Direct connection", port 5432). Used only for schema
#   migrations, which don't play well with the pooler.
DIRECT_URL="postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres"

# --- Auth.js (Google OAuth) ---
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Random 32+ byte secret. Generate with: openssl rand -base64 33
AUTH_SECRET=""

# --- Supabase Storage (waiver PDFs) ---
SUPABASE_URL="https://xxxx.supabase.co"
# Service role key (Supabase dashboard -> Project Settings -> API). Server-side
# only — this bypasses row-level security, so it must never reach the client.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Bootstrapping ---
# The owner's login email. Used once by `scripts/seed-owner.ts` to create
# the first admin_roles row. Normally @presentationhs.org — but this exact
# address is also the one allowed exception past the domain check in
# src/lib/auth.ts, for an owner whose school account will be deleted (e.g.
# after graduation) but who keeps maintaining the system from a personal
# account. Being this address only grants entry past the domain gate; owner
# power still comes from the admin_roles row this script creates.
OWNER_EMAIL=""

# --- Vercel Cron ---
# Vercel injects this automatically in production deployments. Set it
# yourself only if you want to test the cron endpoint locally.
CRON_SECRET=""

# --- Simulation harness only (§13) ---
# Enables scripts/simulate.ts to submit as fake students without real Google
# accounts. Set this ONLY on a deployment loaded with fake test data (never
# real student data), run the simulation, then unset it / redeploy without
# it. While set, it's a genuine auth bypass on /api/submissions.
SIMULATION_SECRET=""

# --- Google Sheets roster sync (optional) ---
# A service account, NOT the sign-in OAuth client above — reusing that
# client's scopes would trigger Google's manual app-verification review.
# Set up: Google Cloud Console -> IAM & Admin -> Service Accounts -> create
# one -> Keys -> Add key (JSON) -> enable the Google Sheets API for the
# project. Then create a blank Google Sheet yourself (so it lives in your
# own Drive, with your own storage quota) and share it with the service
# account's email as an Editor. GOOGLE_SHEETS_ROSTER_ID is the long id in
# the sheet's URL: docs.google.com/spreadsheets/d/<THIS PART>/edit. The
# sync writes to a tab named exactly "Roster" — rename or add one with that
# name in the sheet. Leave all three unset to disable the feature entirely;
# the UI then just doesn't show a working sync.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# The JSON key's "private_key" field, pasted as-is (its literal \n sequences
# are converted back to real newlines at runtime).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_SHEETS_ROSTER_ID=""

# --- Owner role-simulation ("view as"), pre-launch testing only ---
# When "true", lets the owner preview the app as student/teacher/staff_admin
# from the admin dashboard — including actually submitting as a chosen
# roster student, to test the real write path. Off by default on purpose:
# once real student data is loaded, this lets the owner act on a real
# student's behalf, which cuts against students exclusively controlling
# their own submissions. Unset before real students use the app, same
# discipline as SIMULATION_SECRET above.
ROLE_SIMULATION_ENABLED="false"
