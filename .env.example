# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.

# --- Database (Supabase Postgres) ---
# DATABASE_URL: the POOLED connection string (Supabase dashboard -> Connect ->
#   "Transaction pooler", port 6543). Used by the running app and the CLI.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres"
# DIRECT_URL: the DIRECT (non-pooled) connection string (Supabase dashboard ->
#   Connect -> "Direct connection", port 5432). Used only for schema
#   migrations, which don't play well with the pooler.
DIRECT_URL="postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres"

# --- Auth.js (Google OAuth) ---
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Random 32+ byte secret. Generate with: openssl rand -base64 33
AUTH_SECRET=""

# --- Supabase Storage (waiver PDFs) ---
SUPABASE_URL="https://xxxx.supabase.co"
# Service role key (Supabase dashboard -> Project Settings -> API). Server-side
# only — this bypasses row-level security, so it must never reach the client.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Bootstrapping ---
# The owner's real @presentationhs.org address. Used once by
# `scripts/seed-owner.ts` to create the first admin_roles row.
OWNER_EMAIL=""

# --- Vercel Cron ---
# Vercel injects this automatically in production deployments. Set it
# yourself only if you want to test the cron endpoint locally.
CRON_SECRET=""

# --- Simulation harness only (§13) ---
# Enables scripts/simulate.ts to submit as fake students without real Google
# accounts. Set this ONLY on a deployment loaded with fake test data (never
# real student data), run the simulation, then unset it / redeploy without
# it. While set, it's a genuine auth bypass on /api/submissions.
SIMULATION_SECRET=""
